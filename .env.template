# Docker environment configuration for Warren Bot
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control!

# GENERAL
LOGGING=DEBUG
DEBUG_MODE=false

# Discord
DISCORD_TOKEN=your_discord_bot_token_here
# Optional Configuration
DISCORD_APP_ID=your_discord_application_id
DISCORD_PUBLIC_KEY=your_discord_public_key

# FRED (Federal Reserve Economic Data)
FRED_KEY=abc1234567890123abc12345

# CLUB DATA
CLUB_BOT=FALSE
CLUB_INFO_FILE=./club_info.json
CLUB_STOCKS_FILE=./club_stocks.csv

# How to get these values:
# 1. Discord Token: https://discord.com/developers/applications
# 2. Create a new application, go to "Bot" section, and copy the token
# 3. For App ID and Public Key, check the "General Information" section

# Note: yfinance doesn't require an API key - one of the benefits of the migration!